{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "allowJs": true,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "types": ["jest", "node"]
  },
  "exclude": ["dist", "node_modules"],
  "include": ["__fixtures__", "__tests__", "src", "jest.config.js", "rollup.config.ts"]
}
