{
  "name": "action-deployment-manifest",
  "description": "git action that maintains a deployment manifest of the matrix of environments, deployables, versions, and statuses",
  "version": "0.0.0",
  "author": "dkhunt27",
  "type": "module",
  "private": false,
  "homepage": "https://github.com/actions/dkhunt27/action-deployment-manifest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/dkhunt27/action-deployment-manifest.git"
  },
  "bugs": {
    "url": "https://github.com/actions/dkhunt27/action-deployment-manifest/issues"
  },
  "keywords": [
    "actions",
    "git",
    "deployment",
    "manifest",
    "github",
    "ci",
    "cd",
    "github-actions"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "oxlint",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "npx rollup --config rollup.config.ts",
    "package:watch": "npm run package -- --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run coverage && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@aws-sdk/client-dynamodb": "^3.1168.0",
    "@aws-sdk/lib-dynamodb": "^3.1168.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "async": "^3.2.6",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@github/local-action": "^7.0.1",
    "@jest/globals": "^30.2.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/async": "^3.2.26",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "jest": "^30.5.2",
    "jest-mock-extended": "^4.0.2",
    "make-coverage-badge": "^1.2.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "rollup": "^4.68.3",
    "ts-jest": "^29.4.15",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
